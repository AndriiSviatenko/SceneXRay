*.app

# Crashlytics
crashlytics-build.properties

# Packed addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ── SceneXRay runtime state (never commit) ─────────────────────
# Saved graph arrangements live in UserSettings/ (already ignored),
# scan cache / snapshots / bookmarks live in Library/ (already ignored).

# ── OS ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── AI assistant / agent tooling ───────────────────────────────
# Local scratch, session state and per-machine config from coding agents.
# None of this belongs to the product and none of it ships in the package.
.claude/
.cursor/
.cursorignore
.cursorrules
.aider*
.continue/
.windsurf/
.windsurfrules
.codeium/
